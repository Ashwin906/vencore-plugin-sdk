{
  "name": "@vencore/plugin-types",
  "version": "0.0.3",
  "description": "Type definitions for Vencore plugins",
  "author": "Vencore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kavin-charles/vencore-plugin-sdk.git"
  },
  "keywords": [
    "vencore",
    "plugin",
    "types"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}