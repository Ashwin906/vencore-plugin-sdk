{
  "name": "@vencore/plugin-cli",
  "version": "0.0.1",
  "description": "CLI for scaffolding, building, and validating Vencore plugins",
  "author": "Vencore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vencore/vencore-plugin-sdk.git"
  },
  "keywords": [
    "vencore",
    "plugin",
    "cli",
    "scaffold"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
